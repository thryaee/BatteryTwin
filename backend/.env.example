# ─────────────────────────────────────────────
#  BatteryTwin Backend – Environment Variables
# ─────────────────────────────────────────────

# --- App ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=               # leave blank if no auth
MQTT_PASSWORD=               # leave blank if no auth
MQTT_TOPIC_DATA=chargex/battery/data
MQTT_TOPIC_RELAY=chargex/relay/control

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=batterytwin
DB_USER=postgres
DB_PASSWORD=yourpassword

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Simulator ---
# Set to "true" to use the built-in simulator instead of real ESP32 hardware.
# Set to "false" when real ESP32 hardware is connected.
USE_SIMULATOR=true
SIMULATOR_INTERVAL_SECONDS=2

# --- ML Models ---
# Path where trained model files (.pkl) are saved/loaded
ML_MODEL_DIR=ml/saved_models

# --- Relay ---
# Safety thresholds – charging stops if any of these are exceeded
RELAY_MAX_TEMP_C=45.0
RELAY_MIN_VOLTAGE_V=2.5
RELAY_MAX_VOLTAGE_V=4.25
RELAY_MAX_CURRENT_A=3.0
