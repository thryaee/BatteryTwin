# ─────────────────────────────────────────────────────────────────
#  BatteryTwin Backend – Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=               # leave blank if no auth
MQTT_PASSWORD=               # leave blank if no auth
MQTT_TOPIC_DATA=chargex/battery/data
MQTT_TOPIC_RELAY=chargex/relay/control

# --- Database (PostgreSQL) ---
# Option A: individual vars (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=batterytwin
DB_USER=postgres
DB_PASSWORD=yourpassword

# Option B: full connection string (Render injects this automatically)
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS ---
# Local development:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production (Render): set to your deployed frontend URL, e.g.:
# CORS_ORIGINS=https://batterytwin-frontend.onrender.com

# --- Simulator ---
# Set to "true" to use the built-in simulator instead of real ESP32 hardware.
USE_SIMULATOR=true
SIMULATOR_INTERVAL_SECONDS=2

# --- ML Models ---
ML_MODEL_DIR=ml/saved_models

# --- Relay Safety Thresholds ---
RELAY_MAX_TEMP_C=45.0
RELAY_MIN_VOLTAGE_V=2.5
RELAY_MAX_VOLTAGE_V=4.25
RELAY_MAX_CURRENT_A=3.0

# --- Authentication (JWT) ---
# REQUIRED for production – generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_BEFORE_DEPLOYING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password Policy ---
PASSWORD_MIN_LENGTH=8

# --- Rate Limiting ---
AUTH_RATE_LIMIT=10/minute

# --- Admin Bootstrap ---
# Create the first admin account via CLI (never via env vars):
#   cd backend && python create_admin.py
