# ─────────────────────────────────────────────────────────────────
#  BatteryTwin Frontend – Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# Local development:
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# Production (Render) – set these in the Render dashboard:
# REACT_APP_API_BASE_URL=https://batterytwin-backend.onrender.com
# REACT_APP_WS_URL=wss://batterytwin-backend.onrender.com/ws

REACT_APP_POLL_INTERVAL_MS=5000
