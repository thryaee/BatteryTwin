# ─────────────────────────────────────────────────────────────────
#  BatteryTwin Frontend – Production Environment
#
#  This file is committed to git and used during `npm run build`.
#  It contains ONLY non-secret, public configuration.
#
#  REACT_APP_API_BASE_URL must be overridden in the Render dashboard
#  under Environment Variables after the backend is deployed.
#
#  Render injects env vars at build time when set in the dashboard,
#  so the values below are fallback placeholders only.
# ─────────────────────────────────────────────────────────────────

# Replace with your actual Render backend URL after deploying:
# https://batterytwin-backend.onrender.com
REACT_APP_API_BASE_URL=https://batterytwin-backend.onrender.com

# Replace with your actual Render backend WebSocket URL:
# wss://batterytwin-backend.onrender.com/ws
REACT_APP_WS_URL=wss://batterytwin-backend.onrender.com/ws

REACT_APP_POLL_INTERVAL_MS=5000

# Treat ESLint warnings as warnings not errors in production build
ESLINT_NO_DEV_ERRORS=true
